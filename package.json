{
  "name": "ai-story-teller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx apps/api/index.ts",
    "api:serve": "tsx apps/api/ownerServer.ts",
    "api:build": "node scripts/prepare-api-dist.mjs --clean && tsc -p tsconfig.api.json && node scripts/prepare-api-dist.mjs",
    "api:render:build": "npm ci --include=dev && npm run api:build && npm prune --omit=dev",
    "api:hosted": "node dist-api/apps/api/hostedServer.js",
    "api:db:migrate": "node dist-api/apps/api/migrateSchema.js",
    "api:db:migrate:dev": "tsx apps/api/migrateSchema.ts",
    "api:deploy:parity": "node scripts/api-deployment-parity.mjs",
    "api:postgres:import": "tsx apps/api/importPostgres.ts",
    "api:test": "vitest run apps/api",
    "api:test:postgres": "vitest run apps/api/postgres.integration.test.ts",
    "api:smoke": "node scripts/api-production-smoke.mjs",
    "owner:postgres:init": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-postgres.ps1 init",
    "owner:postgres:start": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-postgres.ps1 start",
    "owner:postgres:migrate-utf8": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-postgres.ps1 migrate-utf8",
    "owner:postgres:status": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-postgres.ps1 status",
    "owner:postgres:stop": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-postgres.ps1 stop",
    "owner:watch": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-tunnel-watchdog.ps1",
    "owner:watch:start": "powershell.exe -ExecutionPolicy Bypass -File scripts/start-owner-watchdog.ps1",
    "owner:watch:once": "powershell.exe -ExecutionPolicy Bypass -File scripts/owner-tunnel-watchdog.ps1 -Once",
    "pages:set-api": "node scripts/set-pages-api-url.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke:prod": "node scripts/production-smoke.mjs",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "vitest": "^4.1.7"
  }
}
