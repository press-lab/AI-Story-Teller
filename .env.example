# Local backend only. Keep this file committed; keep real secrets in .env.

AIST_API_HOST=127.0.0.1
AIST_API_PORT=8787
AIST_API_DATA_FILE=.local-backend/aist-api-db.json
AIST_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://press-lab.github.io

# Optional. If unset and AIST_ADMIN_EMAILS is empty, local admin routes are open for owner dev only.
AIST_API_ADMIN_KEY=
AIST_ADMIN_EMAILS=

# Backend-owned provider config. Browser users do not see or edit these.
AIST_PROVIDER_NAME=deepseek
AIST_PROVIDER_BASE_URL=https://api.deepseek.com
AIST_PROVIDER_MODEL=deepseek-chat
AIST_PROVIDER_API_KEY=
AIST_PROVIDER_TEMPERATURE=0.7
AIST_PROVIDER_MAX_OUTPUT_TOKENS=1200

# reviewOnly logs draft policy decisions without blocking reviewed categories.
# enforce blocks local owner-test traffic using the draft policy pack.
AIST_POLICY_MODE=reviewOnly

# Local-only Google stub. Keep true only for owner/dev testing.
AIST_API_ALLOW_LOCAL_GOOGLE_STUB=true

# Real Google OAuth. Configure these from Google Cloud Console.
AIST_GOOGLE_CLIENT_ID=
AIST_GOOGLE_CLIENT_SECRET=
AIST_GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
AIST_WEB_APP_URL=http://localhost:5173/
