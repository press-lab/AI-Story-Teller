# Local backend only. Keep this file committed; keep real secrets in .env.

AIST_API_HOST=127.0.0.1
AIST_API_PORT=8787
AIST_API_DATA_FILE=.local-backend/aist-api-db.json
AIST_DATABASE_URL=
DATABASE_DIRECT_URL=
AIST_DATABASE_POOL_MAX=10
AIST_DATABASE_CONNECTION_TIMEOUT_MS=5000
AIST_DATABASE_IDLE_TIMEOUT_MS=30000
AIST_DATABASE_STATEMENT_TIMEOUT_MS=30000
AIST_DATABASE_LOCK_TIMEOUT_MS=5000
AIST_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
AIST_TRUST_PROXY_HOPS=0
AIST_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://story.storymodeai.com,https://press-lab.github.io

# Owner-hosted UAT:
# - keep AIST_API_HOST=127.0.0.1 and expose it through an HTTPS tunnel/domain
# - use AIST_API_HOST=0.0.0.0 only if you intentionally want LAN/public binding
#   and have set firewall/reverse-proxy protections
# - expose the API through HTTPS, then set this same URL as the GitHub repo variable
#   AIST_PUBLIC_API_BASE_URL with `npm.cmd run pages:set-api -- https://api.storymodeai.com`
AIST_PUBLIC_API_BASE_URL=
AIST_ALLOW_PUBLIC_BIND=false

# Optional for api:dev. Required for api:serve.
# If unset and AIST_ADMIN_EMAILS is empty, local dev admin routes are open for owner dev only.
AIST_API_ADMIN_KEY=
AIST_ADMIN_EMAILS=

# Backend-owned provider config. Browser users do not see or edit these.
AIST_PROVIDER_NAME=deepseek
AIST_PROVIDER_BASE_URL=https://api.deepseek.com
AIST_PROVIDER_MODEL=deepseek-chat
AIST_PROVIDER_API_KEY=
AIST_PROVIDER_TEMPERATURE=0.7
AIST_PROVIDER_MAX_OUTPUT_TOKENS=1200
# Optional OpenRouter routing preference: price, latency, or throughput. Blank uses OpenRouter's balanced default.
AIST_PROVIDER_OPENROUTER_SORT=
# Optional OpenRouter data policy: allow or deny. Use allow when a model has no endpoints under stricter key privacy.
AIST_PROVIDER_OPENROUTER_DATA_COLLECTION=

# reviewOnly logs draft policy decisions without blocking reviewed categories.
# enforce blocks local owner-test traffic using the draft policy pack.
AIST_POLICY_MODE=reviewOnly

# Local-only Google stub. api:serve disables this even if this value is true.
AIST_API_ALLOW_LOCAL_GOOGLE_STUB=true

# Real Google OAuth. Configure these from Google Cloud Console.
AIST_GOOGLE_CLIENT_ID=
AIST_GOOGLE_CLIENT_SECRET=
AIST_GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
AIST_WEB_APP_URL=http://localhost:5173/

# Password account creation always requires a valid invite. Modes:
# - emailVerification (default): send verification email before activation
# - trustedInvite: controlled reviewOnly UAT with email delivery disabled; a
#   valid invite creates an active, unverified account and signs it in
# - disabled: reject password signup even when an invite is supplied
AIST_PASSWORD_SIGNUP_MODE=emailVerification

# Transactional account email. Email-backed signup and password recovery require
# resend delivery with a verified sender identity. trustedInvite keeps recovery
# and verification delivery off.
AIST_EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
AIST_EMAIL_FROM=AI Story Teller <accounts@storymodeai.com>

# Hosted Render API:
# - use `npm run api:hosted` as the Render start command
# - Render provides PORT automatically; do not set AIST_API_PORT unless you need
#   an explicit override
# - set AIST_API_HOST=0.0.0.0 or omit it so api:hosted defaults to 0.0.0.0
# - set AIST_DATABASE_URL or DATABASE_URL to the Neon Postgres connection string
# - set AIST_API_ALLOWED_ORIGINS to explicit HTTPS frontend origins
# - set AIST_TRUST_PROXY_HOPS=1 for Render's final reverse-proxy hop
# - keep AIST_POLICY_MODE=reviewOnly until the policy pack is manually reviewed
# - current no-email UAT uses AIST_EMAIL_DELIVERY_MODE=disabled with
#   AIST_PASSWORD_SIGNUP_MODE=trustedInvite; never use trustedInvite with enforce
# - later email-backed production uses AIST_EMAIL_DELIVERY_MODE=resend with
#   AIST_PASSWORD_SIGNUP_MODE=emailVerification plus RESEND_API_KEY and AIST_EMAIL_FROM
#
# Cloudflare Pages frontend:
# VITE_AIST_RUNTIME_MODE=hostedBackend
# VITE_AIST_API_BASE_URL=https://api.storymodeai.com
